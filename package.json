{
  "name": "bloom-tap",
  "version": "1.2.0",
  "private": true,
  "description": "Bloom Tap : un jeu de réflexes, fais éclore les fleurs avant qu'elles ne fanent.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.6.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "engines": { "node": ">=20" }
}
